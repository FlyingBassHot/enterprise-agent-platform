# Copy to .env for local development.
APP_ENV=dev
APP_DEBUG=true
# Docker Compose frontend port; change if 8080 is already in use.
FRONTEND_PORT=8080
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=dev-secret-change-me
APP_DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
APP_STORAGE_DIR=./data/files
APP_AUTO_CREATE_TABLES=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
# Leave empty to let scripts/seed.py generate a random password in data/initial_admin_password.txt
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_TOKEN=
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible endpoint (vLLM/LiteLLM). Mock provider works offline.
APP_LLM_BASE_URL=http://127.0.0.1:8000/v1
APP_LLM_API_KEY=not-needed
APP_LLM_MODEL=local-model

# Rate limits / quotas / audit trail
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN_PER_MINUTE=100
APP_RATE_LIMIT_EXECUTION_PER_MINUTE=30
APP_RATE_LIMIT_UPLOAD_PER_MINUTE=20
APP_USER_STORAGE_QUOTA_MB=200
APP_AUDIT_LOG_ENABLED=true

# Outbound egress for the built-in platform_http_request tool (empty = disabled)
# Exact hosts or leading-dot suffixes, comma separated.
APP_HTTP_TOOL_ALLOWED_HOSTS=
APP_HTTP_TOOL_MAX_RESPONSE_KB=256

# Runtime loop: iteration budget fallback and context compaction
APP_CONTEXT_CHAR_BUDGET=60000
APP_CONTEXT_KEEP_RECENT_MESSAGES=6
# Per-resource cap for workspace reads (bytes)
APP_ENVIRONMENT_MAX_RESOURCE_BYTES=10485760

# Knowledge retrieval (offline hash embeddings by default; optional OpenAI-compatible endpoint)
APP_EMBEDDING_PROVIDER=hash
APP_EMBEDDING_MODEL=hash-384
# APP_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# APP_EMBEDDING_API_KEY=
# APP_SKILL_SCAN_ROOT=
