# Place real values in backend/container secret environment. Do not commit them.
# Both the installer AND the long-running backend need these variables, since
# the backend resolves TOOL_SECRET references when spawning each MCP process.
TOOL_SECRET_POSTGRAD_BRAVE_API_KEY=
TOOL_SECRET_POSTGRAD_AMAP_API_KEY=
TOOL_SECRET_POSTGRAD_SMTP_PASSWORD=
TOOL_SECRET_POSTGRAD_WECOM_WEBHOOKS=
# Exact school hosts, no wildcard. No public fetches without this list.
POSTGRAD_PUBLIC_HOSTS=
